<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Antojitos SuperMarket</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 240px;
            --brand-color: #1a3a5c;
            --brand-accent: #e8b923;
        }

        body {
            display: flex;
            min-height: 100vh;
            background-color: #f4f6f9;
        }

        /* ── Sidebar ── */
        #sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: var(--brand-color);
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            transition: width .25s ease;
        }

            #sidebar .brand {
                background: rgba(0,0,0,.25);
                padding: 1.2rem 1rem;
                display: flex;
                align-items: center;
                gap: .6rem;
            }

            #sidebar .brand-icon {
                font-size: 1.8rem;
                color: var(--brand-accent);
            }

            #sidebar .brand-text {
                font-size: .95rem;
                font-weight: 700;
                line-height: 1.2;
            }

            #sidebar .nav-link {
                color: rgba(255,255,255,.75);
                padding: .75rem 1.2rem;
                border-radius: 0;
                display: flex;
                align-items: center;
                gap: .7rem;
                transition: background .2s, color .2s;
            }

                #sidebar .nav-link:hover,
                #sidebar .nav-link.active {
                    background: rgba(255,255,255,.12);
                    color: #fff;
                }

                #sidebar .nav-link i {
                    font-size: 1.1rem;
                    width: 20px;
                    text-align: center;
                }

            #sidebar .nav-section {
                font-size: .7rem;
                font-weight: 700;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: rgba(255,255,255,.4);
                padding: 1rem 1.2rem .3rem;
            }

            #sidebar .sidebar-footer {
                margin-top: auto;
                border-top: 1px solid rgba(255,255,255,.1);
                padding: 1rem;
            }

        /* ── Main content ── */
        #main-content {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* ── Top navbar ── */
        #topbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: .6rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 99;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
        }

            #topbar .page-title {
                font-size: 1.1rem;
                font-weight: 600;
                color: var(--brand-color);
                margin: 0;
            }

        .page-content {
            padding: 1.5rem;
            flex: 1;
        }

        /* ── Cards ── */
        .card {
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
        }

        .card-header {
            font-weight: 600;
        }

        /* ── Alerts ── */
        .toast-container {
            z-index: 9999;
        }

        /* ── Responsive ── */
        @@media (max-width: 768px) {
            #sidebar {
                width: 0;
                overflow: hidden;
            }

                #sidebar.open {
                    width: var(--sidebar-width);
                }

            #main-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <nav id="sidebar">
        <div class="brand">
            <i class="bi bi-cart4 brand-icon"></i>
            <div class="brand-text">Antojitos<br /><small style="font-weight:400;font-size:.75rem">SuperMarket</small></div>
        </div>

        <ul class="nav flex-column pt-2">

            @if (User.IsInRole("Admin"))
            {
                <li class="nav-section">Administración</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                       ?.ToString() == "Admin" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Panel Administrador
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                   ?.ToString() == "Account" ? "active" : "")"
                   asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus"></i> Registrar Cajero
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                   ?.ToString() == "Products" ? "active" : "")"
                   asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Productos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                   ?.ToString() == "Customers" ? "active" : "")"
                   asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i> Clientes
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                   ?.ToString() == "Reports" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph"></i> Reportes
                </a>
            </li>
                        }

            @if (User.IsInRole("Cashier"))
            {
                <li class="nav-section">Ventas</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                       ?.ToString() == "Sales" ? "active" : "")"
                   asp-controller="Sales" asp-action="Index">
                    <i class="bi bi-bag-check"></i> Registrar Venta
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]
                                   ?.ToString() == "Customers" ? "active" : "")"
                   asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i> Clientes
                </a>
            </li>
                        }

        </ul>

        <!-- User info in sidebar footer -->
        <div class="sidebar-footer">
            @if (User.Identity!.IsAuthenticated)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center
                                justify-content-center fw-bold"
                         style="width:34px;height:34px;font-size:.85rem">
                        @User.Identity.Name![..1].ToUpper()
                    </div>
                    <div style="font-size:.8rem;line-height:1.2;overflow:hidden">
                        <div class="text-white fw-semibold text-truncate">@User.Identity.Name</div>
                        <div style="color:rgba(255,255,255,.5)">
                            @if (User.IsInRole("Admin"))
                            {
                                <span>Administrador</span>
                            }
                            else
                            {
                                <span>Cajero</span>
                            }
                        </div>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm w-100"
                            style="background:rgba(255,255,255,.1);color:#fff;border:none">
                        <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
                    </button>
                </form>
            }
        </div>
    </nav>

    <!-- Main -->
    <div id="main-content">

        <!-- Top bar -->
        <div id="topbar">
            <h6 class="page-title">
                <i class="bi bi-chevron-right me-1" style="font-size:.8rem"></i>
                @ViewData["Title"]
            </h6>

            <div class="d-flex align-items-center gap-3">
                <span class="text-muted" style="font-size:.85rem">
                    <i class="bi bi-calendar3 me-1"></i>
                    @DateTime.Now.ToString("dddd, MMMM dd yyyy")
                </span>
            </div>
        </div>

        <!-- Page content -->
        <div class="page-content">

            <!-- Global success/error alerts from TempData -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>