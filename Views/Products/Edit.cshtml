@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square"></i>
                <span>Edit Product — <strong>@Model.Code</strong></span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Code" class="form-control text-uppercase bg-light"
                               placeholder="Code" readonly />
                        <label asp-for="Code">Product Code (read-only)</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Name" />
                        <label asp-for="Name">Product Name</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="UnitPrice" class="form-control" type="number"
                               placeholder="0.00" min="0" step="0.01" />
                        <label asp-for="UnitPrice">Unit Price</label>
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="StockQuantity" class="form-control" type="number"
                               placeholder="0" min="0" />
                        <label asp-for="StockQuantity">Stock Quantity</label>
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill text-dark fw-semibold">
                            <i class="bi bi-check-lg me-1"></i>Update Product
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>